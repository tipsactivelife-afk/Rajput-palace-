# ════════════════════════════════════════════════════════════════════
# Rajput Palace — environment variables
# Copy this file to .env.local for local development, and add the same
# variables in your Vercel project settings for production.
# NEVER commit .env.local or real secrets to GitHub.
# ════════════════════════════════════════════════════════════════════

# ── Supabase (required for live data — the site falls back to demo
#    content automatically if these are left empty) ───────────────────
# Find these in Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — DO NOT prefix with NEXT_PUBLIC_. Required for the
# admin panel at /admin (rooms, gallery, testimonials, bookings, settings).
# Find it in Supabase: Project Settings → API → service_role (secret).
# Never referenced by any client-side code — only inside src/app/api/admin/**.
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin panel (/admin) ────────────────────────────────────────────
# The password used to sign in at /admin/login. Choose something strong;
# there is currently a single shared admin password (no user accounts).
ADMIN_PASSWORD=

# A random secret used to sign the admin login session cookie. Any long
# random string works — e.g. generate one with:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=

# ── Hotel contact details ───────────────────────────────────────────
# Not yet provided by the hotel owner — leave blank until confirmed.
# Phone: digits only or with +country code, e.g. +919876543210
NEXT_PUBLIC_HOTEL_PHONE=
# WhatsApp: digits only, with country code, e.g. 919876543210 (no +, no spaces)
NEXT_PUBLIC_HOTEL_WHATSAPP=
