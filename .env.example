# ════════════════════════════════════════════════════════════════════
# Rajput Palace — environment variables
# Copy this file to .env.local for local development, and add the same
# variables in your Vercel project settings for production.
# NEVER commit .env.local or real secrets to GitHub.
# ════════════════════════════════════════════════════════════════════

# ── Supabase (required for live data — the site falls back to demo
#    content automatically if these are left empty) ───────────────────
# Find these in Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — DO NOT prefix with NEXT_PUBLIC_. Only needed if/when
# you build a protected admin route. Never referenced by client code.
# SUPABASE_SERVICE_ROLE_KEY=

# ── Hotel contact details ───────────────────────────────────────────
# Not yet provided by the hotel owner — leave blank until confirmed.
# Phone: digits only or with +country code, e.g. +919876543210
NEXT_PUBLIC_HOTEL_PHONE=
# WhatsApp: digits only, with country code, e.g. 919876543210 (no +, no spaces)
NEXT_PUBLIC_HOTEL_WHATSAPP=
NEXT_PUBLIC_HOTEL_EMAIL=

# ── Location ─────────────────────────────────────────────────────────
# Optional: a specific Google Maps share link for "Get Directions" and
# the embedded map. If left blank, the site builds a maps search URL
# automatically from the hotel address — no paid Maps API key needed.
NEXT_PUBLIC_GOOGLE_MAPS_URL=

# ── Site ─────────────────────────────────────────────────────────────
# Your production URL, used for canonical links, sitemap.xml and Open
# Graph tags. Set this to the real Vercel/custom domain after deploying.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

